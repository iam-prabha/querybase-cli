# querybase keys. Set them here or export them; stored keys (set-key) are used only when
# the matching environment variable is not set.

# Page fetch (crawl) — Bright Data
BRIGHTDATA_API_KEY=
BRIGHTDATA_WEB_UNLOCKER_ZONE=

# Vector storage (index, ask) — Qdrant cloud
QDRANT_URL=
QDRANT_API_KEY=

# Embeddings (index, ask) — any OpenAI compatible endpoint.
# Change the base url, model, and dimensions to match the provider you use.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1024

# Sections retrieved per question (default 5)
# ASK_TOP_K=5
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=
GENERATION_BASE_URL=
GENERATION_MODEL=