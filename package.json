{
  "name": "querybase",
  "version": "0.1.0",
  "description": "Turn documentation websites into a citation-backed RAG index",
  "type": "module",
  "bin": {
    "querybase": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx --env-file=.env src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@brightdata/sdk": "^1.2.0",
    "@inquirer/password": "^5.1.1",
    "@qdrant/js-client-rest": "^1.19.0",
    "commander": "^15.0.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "remark": "^15.0.1",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@types/turndown": "^5.0.6",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
